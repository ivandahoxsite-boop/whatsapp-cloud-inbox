PHONE_NUMBER_ID=
KAPSO_API_KEY=
WABA_ID=
# Optional: custom API endpoint (defaults to https://api.kapso.ai/meta/whatsapp)
WHATSAPP_API_URL=
# Required: password to open the inbox (browser login prompt)
INBOX_PASSWORD=
# Optional: login username (defaults to "admin")
INBOX_USERNAME=

# Optional: CRM SQLite file (defaults to ./data/crm.db). Needs persistent disk.
CRM_DB_PATH=

# --- CRM integrations (Kapso webhook + OpenClaw agent) ---
# Same value you set as secret_key when creating the Kapso webhook
KAPSO_WEBHOOK_SECRET=
# Bearer token OpenClaw uses to read the CRM and PROPOSE messages (cannot send)
CRM_AGENT_TOKEN=
# Optional, different secret: lets a trusted Telegram button handler approve+send. Leave empty to approve only in the CRM web UI
CRM_APPROVER_TOKEN=
# Optional safety cap on WhatsApp messages sent from the CRM (default 20)
CRM_MAX_SENDS_PER_HOUR=
