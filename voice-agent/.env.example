# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# --- Cerebro (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Oído: voz a texto (Deepgram) ---
DEEPGRAM_API_KEY=

# --- Voz: texto a voz (ElevenLabs) ---
ELEVENLABS_API_KEY=
# ID de la voz femenina paisa (clonada o diseñada en ElevenLabs)
ELEVENLABS_VOICE_ID=

# --- Telefonía (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número desde el que se llama, formato +57...
TWILIO_FROM_NUMBER=
# Dominio público donde corre este servidor (sin https://), p. ej. abc123.ngrok.app
PUBLIC_HOST=
# Grabar las llamadas (el agente lo avisa al inicio)
GRABAR_LLAMADAS=true

# --- Datos del negocio ---
EMPRESA=Cartera Ejemplo S.A.S.
NOMBRE_AGENTE=Valentina
DEUDORES_ARCHIVO=datos/deudores.ejemplo.json
RESULTADOS_ARCHIVO=datos/resultados.jsonl

# --- Límites de contacto (verifícalos con tu abogado; Ley 2300 de 2023) ---
MAX_CONTACTOS_DIA=1
MAX_CONTACTOS_SEMANA=2
