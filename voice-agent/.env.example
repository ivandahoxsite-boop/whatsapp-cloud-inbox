# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# --- Cerebro ---
# Opción A, Claude:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Opción B, MiniMax (API compatible con Anthropic): descomenta y usa tu llave de MiniMax
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_API_KEY=<llave de MiniMax>
# CLAUDE_MODEL=MiniMax-M2.7

# --- Oído: voz a texto ---
# deepgram (rápido, pago por minuto) o whisper (gratis, corre en tu servidor; lento sin GPU)
OIDO_PROVEEDOR=deepgram
DEEPGRAM_API_KEY=
# Modelo de Whisper: small (más rápido) o medium (más preciso)
WHISPER_MODELO=small

# --- Voz: texto a voz ---
# elevenlabs o minimax
VOZ_PROVEEDOR=elevenlabs
# Opción MiniMax: voz del sistema (p. ej. Spanish_SereneWoman) o una diseñada (ttv-voice-...)
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=Spanish_SereneWoman
# speech-2.8-hd (más natural) o speech-2.8-turbo (más rápido)
MINIMAX_MODELO=speech-2.8-hd
MINIMAX_VELOCIDAD=1.1
MINIMAX_GROUP_ID=
# Opción ElevenLabs:
ELEVENLABS_API_KEY=
# ID de la voz femenina paisa (clonada o diseñada en ElevenLabs)
ELEVENLABS_VOICE_ID=

# --- Telefonía (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número desde el que se llama, formato +57...
TWILIO_FROM_NUMBER=
# Dominio público donde corre este servidor (sin https://), p. ej. abc123.ngrok.app
PUBLIC_HOST=
# Grabar las llamadas (el agente lo avisa al inicio)
GRABAR_LLAMADAS=true

# --- Datos del negocio ---
EMPRESA=Xsite Group
NOMBRE_AGENTE=Valentina
# Número que la agente puede dar para devolver la llamada (en palabras o dígitos)
TELEFONO_CONTACTO=
DEUDORES_ARCHIVO=datos/deudores.ejemplo.json
RESULTADOS_ARCHIVO=datos/resultados.jsonl

# --- Límites de contacto (verifícalos con tu abogado; Ley 2300 de 2023) ---
MAX_CONTACTOS_DIA=1
MAX_CONTACTOS_SEMANA=2
